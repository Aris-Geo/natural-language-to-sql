# =============================================================================
# DEMO ENVIRONMENT SETTINGS
# =============================================================================
DEBUG=true
ENVIRONMENT=development

# =============================================================================
# DEMO DATABASE (Local PostgreSQL)
# =============================================================================
# This demo environment uses a local PostgreSQL container with sample data
DEFAULT_DB_HOST=postgres
DEFAULT_DB_PORT=5432
DEFAULT_DB_NAME=ecommerce_demo
DEFAULT_DB_USERNAME=demo_user
DEFAULT_DB_PASSWORD=demo_pass

# =============================================================================
# LLM SETTINGS (Lightweight for demo)
# =============================================================================
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=codellama:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30

# =============================================================================
# SERVICE SETTINGS
# =============================================================================
GATEWAY_INCLUDE_DEBUG_INFO=true
GATEWAY_INCLUDE_TIMING_INFO=true
EXECUTOR_MAX_ROWS=100
SCHEMA_MAX_SAMPLE_ROWS=3

# =============================================================================
# DEMO-SPECIFIC SETTINGS
# =============================================================================
# These settings are optimized for demo/development
GATEWAY_SERVICE_TIMEOUT=30
GATEWAY_ENABLE_CACHING=false
LOG_LEVEL=INFO